# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots

###> symfony/framework-bundle ###
APP_ENV=test
# Deliberate test-only secret (not used in production).
# Test-only secret - DO NOT use in production
APP_SECRET=test-secret-32-characters-change-me
###< symfony/framework-bundle ###
###> symfony/messenger ###
# In-memory sync transport — no async queue required for this app.
MESSENGER_TRANSPORT_DSN=sync://
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailhog:1025
###< symfony/mailer ###

###> app/pgp ###
PGP_PRIVATE_KEY_PATH=%kernel.project_dir%/config/pgp/private.key
PGP_PRIVATE_KEY_PASSPHRASE=your-secure-passphrase
APP_MAIL_FROM=noreply@example.com
APP_TOKEN_TTL=3600  # 1 hour TTL for tests
###< app/pgp ###

###> app/session ###
SESSION_AUTO_START=true
###< app/session ###

LOCK_DSN=flock
TRUSTED_PROXIES=127.0.0.1
