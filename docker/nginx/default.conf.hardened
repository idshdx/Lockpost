server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name _;

    client_max_body_size 1M;

    # Rate limiting for all requests
    limit_req zone=general burst=20 nodelay;

    # Security headers
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' data:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()" always;
    add_header Strict-Transport-Security "max-age=0" always;

    access_log off;
    error_log /dev/stdout info;

    root /var/www/app/public;
    index index.php index.html index.htm;

    # Deny access to sensitive files and directories
    location ~ /\.(?!well-known).* {
        deny all;
        return 404;
    }
    location ~ ^/(composer\.json|composer\.lock|README\.md|CHANGELOG\.md|LICENSE|docker-compose.*|Dockerfile.*|\.env) {
        deny all;
        return 404;
    }
    location ~ ^/(config|var|tests|src|templates|translations)/ {
        deny all;
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.php?_url=$uri&$args;
    }

    location ~ \.php$ {
        fastcgi_pass php;
        fastcgi_index /index.php;

        include fastcgi_params;
        fastcgi_split_path_info       ^(.+\.php)(/.+)$;
        fastcgi_param PATH_INFO       $fastcgi_path_info;
        fastcgi_param PATH_TRANSLATED $document_root$fastcgi_path_info;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param APP_ENV production;

        # FastCGI timeouts
        fastcgi_connect_timeout 120;
        fastcgi_send_timeout 120;
        fastcgi_read_timeout 120;

        # FastCGI buffers
        fastcgi_buffer_size 128k;
        fastcgi_buffers 4 256k;
        fastcgi_busy_buffers_size 256k;
        fastcgi_temp_file_write_size 256k;
        fastcgi_intercept_errors on;
    }

    location ~ /\.ht {
        deny all;
    }

    # Silence Chrome DevTools automatic probes — return 204 without hitting PHP-FPM
    location = /.well-known/appspecific/com.chrome.devtools.json {
        access_log off;
        return 204;
    }

    # Prevent token strings from leaking into access logs
    location ~ ^/submit/ {
        access_log off;
        try_files $uri $uri/ /index.php?_url=$uri&$args;
    }
    location ~ ^/message/submit {
        access_log off;
        try_files $uri $uri/ /index.php?_url=$uri&$args;
    }

    location /nginx_status {
        stub_status on;
        access_log   off;
        allow 127.0.0.1;
        deny all;
    }

    location ~ ^/(status|ping)$ {
        allow 127.0.0.1;
        deny all;
        access_log off;
        include fastcgi_params;
        fastcgi_pass php:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }
}
