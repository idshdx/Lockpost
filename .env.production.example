###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
# Generate with: openssl rand -hex 32
APP_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_32_CHAR_STRING
###< symfony/framework-bundle ###

###> symfony/mailer ###
# Postfix runs on the VPS host. With bridge networking, the PHP container can
# reach the host via the Docker bridge gateway IP. Find it with:
#   docker network inspect bridge --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
# Typical bridge value is 172.17.0.1.
MAILER_DSN=smtp://172.17.0.1:25
###< symfony/mailer ###

###> app/pgp ###
# Passphrase protecting the server's PGP private key.
# MUST be set for production. An unencrypted (no-protection) private key on a
# production server is a critical security risk. PgpSigningService will refuse
# to boot if this is empty in non-dev environments.
# Generate your key with a passphrase using scripts/init-pgp.sh --with-passphrase <PASSPHRASE>
PGP_PRIVATE_KEY_PASSPHRASE=CHANGE_ME_TO_YOUR_PASSPHRASE
###< app/pgp ###

###> app/mail ###
# The From address used on all outbound emails.
# Replace with a real address at your domain, e.g. noreply@yourdomain.com
APP_MAIL_FROM=noreply@yourdomain.com
###< app/mail ###
