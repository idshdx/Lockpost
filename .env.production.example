###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
# Generate with: openssl rand -hex 32
APP_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_32_CHAR_STRING
###< symfony/framework-bundle ###

###> symfony/mailer ###
# Postfix runs on the VPS host. With network_mode: host, both containers share the host
# network namespace, so use 127.0.0.1 (loopback) to reach Postfix on port 25.
# If you are NOT using network_mode: host, find the Docker bridge gateway with:
#   docker network inspect bridge --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
# Typical bridge value is 172.17.0.1.
MAILER_DSN=smtp://127.0.0.1:25
###< symfony/mailer ###

###> app/pgp ###
# Passphrase protecting the server's PGP private key.
# If the key was generated with %no-protection (the default in scripts/init-pgp.sh), leave blank.
PGP_PRIVATE_KEY_PASSPHRASE=
###< app/pgp ###

###> app/mail ###
# The From address used on all outbound emails.
# Replace with a real address at your domain, e.g. noreply@yourdomain.com
APP_MAIL_FROM=noreply@yourdomain.com
###< app/mail ###
