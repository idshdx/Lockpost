{
  "name": "lockpost/lockpost",
  "type": "project",
  "license": "proprietary",
  "description": "Share a link. Receive a secret. Leave no trace.",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.2",
    "ext-ctype": "*",
    "ext-gnupg": "*",
    "ext-iconv": "*",
    "ext-openssl": "*",
    "ext-posix": "*",
    "phpdocumentor/reflection-docblock": "^5.6.1|^6.0",
    "phpstan/phpdoc-parser": "^1.33|^2.0",
    "symfony/asset": "^8.0",
    "symfony/asset-mapper": "^8.0",
    "symfony/console": "^8.0",
    "symfony/dotenv": "^8.0",
    "symfony/flex": "^2",
    "symfony/form": "^8.0",
    "symfony/framework-bundle": "^8.0",
    "symfony/http-client": "^8.0",
    "symfony/mailer": "^8.0",
    "symfony/mime": "^8.0",
    "symfony/monolog-bundle": "^3.0|^4.0",
    "symfony/rate-limiter": "^8.0",
    "symfony/runtime": "^8.0",
    "symfony/security-bundle": "^8.0",
    "symfony/stimulus-bundle": "^2.21|^3.0",
    "symfony/twig-bundle": "^8.0",
    "symfony/validator": "^8.0",
    "symfony/yaml": "^8.0",
    "twig/extra-bundle": "^2.12|^3.0",
    "twig/twig": "^2.12|^3.0"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true,
    "platform": {
      "php": "8.4"
    },
    "platform-check": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd",
      "importmap:install": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.0.*"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0|^12.0",
    "symfony/browser-kit": "^8.0",
    "symfony/css-selector": "^8.0",
    "symfony/debug-bundle": "^8.0",
    "symfony/maker-bundle": "^1.0",
    "symfony/phpunit-bridge": "^8.0",
    "symfony/stopwatch": "^8.0",
    "symfony/web-profiler-bundle": "^8.0"
  }
}
