<?xml version="1.0" encoding="UTF-8"?>

<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         bootstrap="tests/bootstrap.php"
>
    <php>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <server name="APP_ENV" value="test" force="true"/>
        <server name="SHELL_VERBOSITY" value="-1"/>
        <server name="SYMFONY_PHPUNIT_REMOVE" value=""/>
        <server name="SYMFONY_PHPUNIT_VERSION" value="12"/>
        <env name="APP_ENV" value="test"/>
        <env name="APP_DEBUG" value="1"/>
        <env name="SESSION_AUTO_START" value="false"/>
        <!-- Ensure test env vars are always set regardless of container env_file overrides.
             PGP_PRIVATE_KEY_PASSPHRASE is intentionally omitted: tests/bootstrap.php loads
             .env via Dotenv::bootEnv(), so tests use the passphrase that matches the actual
             deployed key. See PgpSigningServiceTest::setUp(). -->
        <env name="APP_SECRET" value="test-secret-32-chars-long!!"/>
        <env name="APP_MAIL_FROM" value="noreply@example.com"/>
        <env name="MAILER_DSN" value="smtp://mailhog:1025"/>
        <!-- Tests generate tokens directly without registering them in the
             state store; use stateless mode so validateToken() always returns true -->
        <env name="APP_TOKEN_STATEFUL" value="0"/>
    </php>

    <testsuites>
        <testsuite name="Project Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
